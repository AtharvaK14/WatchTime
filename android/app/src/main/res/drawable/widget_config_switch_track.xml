<?xml version="1.0" encoding="utf-8"?>
<!-- The app's switch (.notif-switch): a white track when on, a grey one when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_text" />
            <corners android:radius="100dp" />
            <size android:width="46dp" android:height="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_surface_raised" />
            <stroke android:width="1dp" android:color="@color/widget_control_outline" />
            <corners android:radius="100dp" />
            <size android:width="46dp" android:height="28dp" />
        </shape>
    </item>
</selector>
