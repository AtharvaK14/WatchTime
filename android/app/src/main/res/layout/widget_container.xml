<?xml version="1.0" encoding="utf-8"?>
<!-- Shared shell for both widgets.

     Layout rules that keep resizing safe:
     - The header is a fixed-height row that the list never overlaps; at short
       heights the provider hides it outright rather than letting it eat the
       only visible row.
     - The ListView takes all remaining height (weight=1), so vertical resizing
       changes how many rows are visible and nothing else. It scrolls, so there
       is no height at which content is cropped without recourse.
     - Every text view in the rows is single-line with ellipsis, so horizontal
       resizing narrows text instead of wrapping it into a taller row that
       would misalign the list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"
            android:maxLines="1" />
    </LinearLayout>

    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="@color/widget_muted"
        android:textSize="13sp" />
</LinearLayout>
