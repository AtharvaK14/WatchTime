<?xml version="1.0" encoding="utf-8"?>
<!-- Full Up Next row: the app's Up Next card, at widget scale.
     Poster, then the show name, "S3 E1 · Chapter One" (the code in mono, set
     by spans in WidgetListFactory), and the quiet metadata line
     "+7 more · New · Season premiere" with only "New" in the accent.

     The middle column is the only flexible one (weight=1); the poster and the
     button are fixed, so narrowing the widget shortens the text and never
     pushes the button off the edge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/row_poster"
        android:layout_width="36dp"
        android:layout_height="54dp"
        android:scaleType="centerCrop"
        android:background="@drawable/widget_poster_placeholder"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_show"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/row_episode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/widget_text"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/row_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/widget_muted"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
