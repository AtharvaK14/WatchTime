<?xml version="1.0" encoding="utf-8"?>
<!-- Compact Watch Next row, used when the widget is too narrow or too short
     for the full one. It drops the poster and the episode title - the two
     pieces that stop reading usefully first - and keeps what identifies the
     episode: the show name and the season/episode number. Reducing what is
     shown is deliberate; the alternative at these sizes is ellipsised stubs
     of everything, which identifies nothing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_card_background"
    android:padding="7dp"
    android:layout_marginBottom="5dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_show"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/row_episode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/widget_muted"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_watch_button"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:gravity="center"
        android:background="@drawable/widget_watch_button"
        android:textColor="@color/widget_bg"
        android:textSize="12sp"
        android:text="✓"
        android:contentDescription="@string/widget_mark_watched" />
</LinearLayout>
