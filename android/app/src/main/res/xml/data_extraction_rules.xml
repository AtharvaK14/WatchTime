<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup rules for Android 12 and later
     (android:dataExtractionRules). See backup_rules.xml for why the list is
     exactly this one file; keep the two in step.

     Device-to-device transfer gets the same single file: it is the copy
     designed to be restored into a fresh install, and copying raw WebView
     storage between devices is not something the app has ever been tested
     against. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="external" path="system-backup/watchtime-latest.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="external" path="system-backup/watchtime-latest.json" />
    </device-transfer>
</data-extraction-rules>
