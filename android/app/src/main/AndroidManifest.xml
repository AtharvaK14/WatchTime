<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The episode detail overlay a widget row opens. A separate task
             (excludeFromRecents + noHistory) so it behaves like a pop-up over
             the home screen rather than becoming part of the app's back stack:
             dismissing it returns the user to their launcher, not into the app.

             Deliberately the default launch mode. With singleTask, a second
             row tap would be delivered to the running instance as onNewIntent
             and the overlay would keep showing the FIRST episode; the default
             mode plus the receiver's CLEAR_TOP finishes and recreates it, so
             onCreate always reads the extras it was actually started with.

             Not exported - only our own widget receiver starts it. -->
        <activity
            android:name=".widget.EpisodePanelActivity"
            android:theme="@style/WidgetPanelTheme"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:exported="false" />

        <!-- Home-screen widgets. Both providers are exported because the
             launcher, a different app, has to be able to instantiate them;
             that is how every app widget works and the receiver exposes no
             data of its own. -->
        <receiver
            android:name=".widget.WatchNextWidgetProvider"
            android:exported="true"
            android:label="@string/widget_watch_next_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_watch_next_info" />
        </receiver>

        <receiver
            android:name=".widget.ComingUpWidgetProvider"
            android:exported="true"
            android:label="@string/widget_coming_up_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_coming_up_info" />
        </receiver>

        <!-- Row taps. NOT exported: only our own widgets' PendingIntents
             target it, and nothing outside the app should be able to mark
             episodes watched. -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.indie.watchtime.widget.ROW_CLICK" />
            </intent-filter>
        </receiver>

        <!-- BIND_REMOTEVIEWS keeps the system as the only possible binder. -->
        <service
            android:name=".widget.WidgetListService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Runtime permission on Android 13+ (API 33). Requested only when the
         user turns notifications on in Settings, never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets a scheduled release notification survive a reboot; without it
         every pending alarm is silently dropped when the device restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
